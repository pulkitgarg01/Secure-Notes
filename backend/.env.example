PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/secure_notes
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=20

# Required for first-time admin setup via POST /api/auth/bootstrap-admin
# Pass as header: X-Bootstrap-Token: <value>
BOOTSTRAP_TOKEN=change-me-to-a-random-bootstrap-token
